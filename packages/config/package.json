{
  "name": "@dwm/config",
  "version": "0.1.0",
  "description": "Gestión de configuración extensible por namespace de Dev Workspace Manager (DWM). Registrable como IModule del Core; cada módulo gestiona su propia sección de configuración normalizada (ADR-002 §8), con caché en memoria e integración con @dwm/logger y @dwm/event-bus.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@dwm/core": "*",
    "@dwm/logger": "*",
    "@dwm/event-bus": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5",
    "@types/node": "^20.14.10"
  }
}
