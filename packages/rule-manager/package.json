{
  "name": "@dwm/rule-manager",
  "version": "0.1.0",
  "description": "Módulo 25 — Rule Manager de Dev Workspace Manager (DWM): gestiona las reglas reales detectadas por @dwm/psn-adapter (ficheros Markdown del recurso `rules`), sin base de datos y sin duplicar información. Registrable como IModule del Core.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@dwm/core": "*",
    "@dwm/config": "*",
    "@dwm/logger": "*",
    "@dwm/event-bus": "*",
    "@dwm/workspace": "*",
    "@dwm/portable-workspace": "*",
    "@dwm/import-manager": "*",
    "@dwm/psn-adapter": "*",
    "@dwm/agent-manager": "*",
    "@dwm/skill-manager": "*",
    "@dwm/verification": "*",
    "@dwm/status": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5",
    "@types/node": "^20.14.10"
  }
}
