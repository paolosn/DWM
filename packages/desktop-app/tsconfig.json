{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-electron",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node", "electron"]
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist-electron",
    "dist-renderer",
    "tests",
    "src/renderer",
    "src/preload"
  ]
}
