{
  // Módulo 34 — Empaquetado de escritorio, completado sobre la
  // infraestructura del Módulo 32. `icon.png` es un PLACEHOLDER
  // (generado programáticamente, sin arte final de marca) — sustituir
  // por el icono definitivo de DWM antes de una distribución real.
  appId: "com.dwm.desktop",
  productName: "DWM",
  copyright: "Copyright © DWM",
  // Fijado explícitamente: electron-builder no detecta automáticamente la
  // versión de Electron cuando el paquete está hoisted a la raíz del
  // workspace npm en lugar de packages/desktop-app/node_modules (límite
  // real de este monorepo, documentado en BUILD-REPORT-v1.0.0.md).
  electronVersion: "31.3.1",
  directories: {
    output: "release",
    buildResources: "build",
  },
  files: [
    "dist-electron/**/*",
    "dist-renderer/**/*",
    "package.json",
    "!**/*.map",
    "!**/*.test.*",
    "!node_modules/**/src/**",
    "!node_modules/**/tests/**",
    "!node_modules/**/*.ts",
    "!node_modules/**/tsconfig*.json",
    "!node_modules/**/vitest.config.*",
  ],
  asar: true,
  icon: "build/icon.png",
  win: {
    target: [{ target: "nsis", arch: ["x64"] }],
    icon: "build/icon.png",
  },
  mac: {
    target: [{ target: "dmg", arch: ["x64", "arm64"] }],
    category: "public.app-category.developer-tools",
    icon: "build/icon.png",
    hardenedRuntime: true,
    gatekeeperAssess: false,
  },
  linux: {
    target: [{ target: "AppImage", arch: ["x64"] }],
    icon: "build/icon.png",
    category: "Development",
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "DWM",
    uninstallDisplayName: "DWM (Dev Workspace Manager) ${version}",
    deleteAppDataOnUninstall: false,
  },
  publish: null,
}
