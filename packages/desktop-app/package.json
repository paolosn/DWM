{
  "name": "@dwm/desktop-app",
  "version": "1.0.2",
  "description": "M\u00f3dulo 32 \u2014 Desktop Application de Dev Workspace Manager (DWM): infraestructura Electron + React + TypeScript + Vite sobre la que se construir\u00e1 la interfaz de usuario (M\u00f3dulo 33). Proceso principal seguro (contextIsolation, sin nodeIntegration, preload con contextBridge), IPC tipado hacia la Application API (M\u00f3dulo 31), gesti\u00f3n de ventanas, configuraci\u00f3n persistida, manejo global de errores y AppShell vac\u00edo con navegaci\u00f3n preparada. No implementa pantallas funcionales ni l\u00f3gica de negocio.",
  "private": true,
  "author": "DWM",
  "type": "module",
  "main": "./dist-electron/main/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@dwm/agent-manager": "*",
    "@dwm/ai-creator-manager": "*",
    "@dwm/application-api": "*",
    "@dwm/backup": "*",
    "@dwm/client-manager": "*",
    "@dwm/config": "*",
    "@dwm/environment-manager": "*",
    "@dwm/event-bus": "*",
    "@dwm/import-manager": "*",
    "@dwm/delivery-manager": "*",
    "@dwm/knowledge-manager": "*",
    "@dwm/logger": "*",
    "@dwm/migration": "*",
    "@dwm/plugin": "*",
    "@dwm/portable-package-manager": "*",
    "@dwm/portable-workspace": "*",
    "@dwm/profile": "*",
    "@dwm/project": "*",
    "@dwm/psn-adapter": "*",
    "@dwm/restore": "*",
    "@dwm/rule-manager": "*",
    "@dwm/skill-manager": "*",
    "@dwm/status": "*",
    "@dwm/verification": "*",
    "@dwm/workspace": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@dwm/secrets": "*",
    "@dwm/connections-manager": "*"
  },
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.json",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "package:electron": "npm run build && electron-builder --config build/electron-builder.json5",
    "package:electron:win": "npm run build && electron-builder --win --config build/electron-builder.json5"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.1"
  }
}
