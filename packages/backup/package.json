{
  "name": "@dwm/backup",
  "version": "0.1.0",
  "description": "Sistema central de copias de seguridad de Dev Workspace Manager (DWM): definir, crear, validar, listar, consultar, cancelar, eliminar y conservar backups (completos, selectivos o incrementales) de los datos administrados por DWM, con almacenamiento local abstraído para futuros proveedores. Registrable como IModule del Core.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@dwm/core": "*",
    "@dwm/config": "*",
    "@dwm/logger": "*",
    "@dwm/event-bus": "*",
    "@dwm/scheduler": "*",
    "@dwm/secrets": "*",
    "@dwm/workspace": "*",
    "@dwm/profile": "*",
    "@dwm/project": "*",
    "@dwm/plugin": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5",
    "@types/node": "^20.14.10"
  }
}
